### this is a Design bench code ####

module pcie_endpoint (
    input  logic        clk,
    input  logic        rst,
    input  logic        tx_valid,
    input  logic [31:0] tx_data,
    output logic        rx_valid,
    output logic [31:0] rx_data
);

always_ff @(posedge clk or posedge rst) begin
    if (rst) begin
        rx_valid <= 1'b0;
        rx_data  <= 32'b0;
    end
    else begin
        if (tx_valid) begin
            rx_valid <= 1'b1;
            rx_data  <= tx_data;
        end
        else begin
            rx_valid <= 1'b0;
        end
    end
end

endmodule



